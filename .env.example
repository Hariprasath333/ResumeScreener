# Smart Resume Screener Environment Configuration

# Database
# Default: SQLite for zero-config local dev. Change to PostgreSQL for production.
DATABASE_URL=sqlite:///./resume_screener.db
# DATABASE_URL=postgresql+psycopg2://screener:screenerpass@db:5432/resume_screener

# LLM Configuration
# Options: mock, openai, gemini, ollama
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Limits & Uploads
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads

# Security & Secrets
SECRET_KEY=change-this-secret-key-in-production
